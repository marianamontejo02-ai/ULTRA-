# ============================================================
# ULTRA belleza - Variables de entorno
# ============================================================
# Copia este archivo como .env.local y completa los valores
# NUNCA subas .env.local al repositorio
# ============================================================

# Dominio de tu tienda Shopify (sin https://)
SHOPIFY_STORE_DOMAIN=x0960f-c1.myshopify.com

# Token de Storefront API (NO es el Admin API token)
# Para crearlo: Shopify Admin > Apps > Develop apps >
#   Crear app > API credentials > Storefront API access token
# Permisos necesarios: unauthenticated_read_product_listings,
#   unauthenticated_read_product_inventory,
#   unauthenticated_read_product_tags,
#   unauthenticated_read_collection_listings,
#   unauthenticated_write_checkouts,
#   unauthenticated_read_checkouts,
#   unauthenticated_write_customers,
#   unauthenticated_read_customer_tags
SHOPIFY_STOREFRONT_ACCESS_TOKEN=4173b14f9cc820dcdab7fcead60bb1c3

# Revalidación de caché en segundos (60 = 1 minuto)
REVALIDATION_SECRET=ultra_secret_revalidation_2024

# WhatsApp número de contacto (formato: 573001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567

# URL pública de la tienda
NEXT_PUBLIC_SITE_URL=https://ultra.com.co
