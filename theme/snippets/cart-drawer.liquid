<div id="cart-overlay" class="cart-overlay" aria-hidden="true"></div>

<div id="cart-drawer" class="cart-drawer" role="dialog" aria-label="Carrito de compras" aria-modal="true">
  <div class="cart-drawer__header">
    <div class="cart-drawer__title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      Mi carrito
    </div>
    <button id="cart-close" class="cart-drawer__close" aria-label="Cerrar carrito">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="cart-shipping-bar">
    <p id="shipping-msg">Cargando...</p>
    <div class="shipping-progress">
      <div id="shipping-progress" class="shipping-progress__fill" style="width:0%"></div>
    </div>
  </div>

  <div id="cart-body" class="cart-drawer__body">
    <div class="cart-empty">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <h3>Tu carrito está vacío</h3>
      <p>Agrega productos y vuelve aquí</p>
      <button onclick="Cart.close()" class="btn btn-primary">Ver productos</button>
    </div>
  </div>

  <div class="cart-drawer__footer" id="cart-footer" style="display:none">
    <div class="cart-trust">
      <span class="cart-trust-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Pago seguro
      </span>
      <span class="cart-trust-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
        Devoluciones fáciles
      </span>
      <span class="cart-trust-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        Envío a Colombia
      </span>
    </div>
    <div class="cart-subtotal">
      <span>Subtotal</span>
      <strong id="cart-subtotal">$0</strong>
    </div>
    <p class="cart-tax-note">Impuestos e envío calculados al finalizar el pedido</p>
    <a href="/checkout" class="cart-checkout-btn">Finalizar compra</a>
    <button onclick="Cart.close()" class="cart-continue">Seguir comprando</button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var footer = document.getElementById('cart-footer');
    var body   = document.getElementById('cart-body');
    if (!footer || !body) return;
    var observer = new MutationObserver(function() {
      footer.style.display = document.querySelector('.cart-item') ? '' : 'none';
    });
    observer.observe(body, { childList: true, subtree: true });
  });
</script>
