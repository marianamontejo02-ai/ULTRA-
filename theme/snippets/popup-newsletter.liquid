<!-- Lead capture popup — shown once per session (localStorage gate) -->
<div class="popup-overlay popup--hidden" id="lead-popup" role="dialog" aria-modal="true" aria-label="Oferta especial">
  <div class="popup-card">
    <button class="popup-close" id="popup-close-btn" aria-label="Cerrar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="popup-layout">
      <!-- Left visual -->
      <div class="popup-visual">
        <div class="popup-visual__circle"></div>
        <div class="popup-visual__emoji">✨</div>
        <div class="popup-badge-float popup-badge-float--1">
          <span>🎁</span>
          <strong>10% OFF</strong>
        </div>
        <div class="popup-badge-float popup-badge-float--2">
          <span>📦</span>
          <strong>Envío gratis</strong>
        </div>
      </div>

      <!-- Right form -->
      <div class="popup-content">
        <p class="popup-eyebrow">Solo por hoy</p>
        <h2 class="popup-title">¡Lleva un <mark>10% OFF</mark> en tu primera compra!</h2>
        <p class="popup-desc">Únete a más de 10.000 clientas y recibe descuentos exclusivos, novedades y tutoriales de belleza.</p>

        {% form 'customer', id: 'popup-form', class: 'popup-form' %}
          <div class="popup-field">
            <label for="popup-name" class="sr-only">Tu nombre</label>
            <input
              type="text"
              id="popup-name"
              name="contact[first_name]"
              placeholder="Tu nombre"
              class="popup-input"
              autocomplete="given-name"
            >
          </div>
          <div class="popup-field">
            <label for="popup-email" class="sr-only">Tu correo</label>
            <input
              type="email"
              id="popup-email"
              name="contact[email]"
              placeholder="tu@correo.com"
              class="popup-input"
              required
              autocomplete="email"
            >
          </div>
          <div class="popup-field">
            <label for="popup-phone" class="sr-only">Tu WhatsApp (opcional)</label>
            <input
              type="tel"
              id="popup-phone"
              name="contact[phone]"
              placeholder="WhatsApp (opcional)"
              class="popup-input"
              autocomplete="tel"
            >
          </div>
          <input type="hidden" name="contact[tags]" value="newsletter,popup-lead">
          <button type="submit" class="popup-submit">
            Quiero mi descuento
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        {% endform %}

        <button class="popup-skip" id="popup-skip-btn">No gracias, prefiero pagar precio completo</button>

        <p class="popup-privacy">Sin spam, prometido. Puedes darte de baja en cualquier momento.</p>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var POPUP_KEY = 'ultra_popup_v1';
  var DELAY_MS  = 4000;

  function dismissPopup(forever) {
    var popup = document.getElementById('lead-popup');
    if (!popup) return;
    popup.classList.remove('popup--visible');
    popup.classList.add('popup--closing');
    setTimeout(function() {
      popup.classList.remove('popup--closing');
      popup.classList.add('popup--hidden');
    }, 350);
    if (forever) {
      try { localStorage.setItem(POPUP_KEY, Date.now().toString()); } catch(e) {}
    }
  }

  function maybeShowPopup() {
    try {
      var stored = localStorage.getItem(POPUP_KEY);
      if (stored) {
        var age = Date.now() - parseInt(stored, 10);
        if (age < 7 * 24 * 60 * 60 * 1000) return;
      }
    } catch(e) {}

    setTimeout(function() {
      var popup = document.getElementById('lead-popup');
      if (!popup) return;
      popup.classList.remove('popup--hidden');
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          popup.classList.add('popup--visible');
        });
      });
    }, DELAY_MS);
  }

  document.addEventListener('DOMContentLoaded', function() {
    maybeShowPopup();

    var closeBtn = document.getElementById('popup-close-btn');
    var skipBtn  = document.getElementById('popup-skip-btn');
    var overlay  = document.getElementById('lead-popup');
    var form     = document.getElementById('popup-form');

    if (closeBtn) closeBtn.addEventListener('click', function() { dismissPopup(false); });
    if (skipBtn)  skipBtn.addEventListener('click',  function() { dismissPopup(true); });
    if (overlay)  overlay.addEventListener('click',  function(e) { if (e.target === overlay) dismissPopup(false); });

    if (form) form.addEventListener('submit', function() {
      setTimeout(function() { dismissPopup(true); }, 1500);
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') dismissPopup(false);
    });
  });
})();
</script>
