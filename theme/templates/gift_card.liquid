<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Tarjeta de regalo — {{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: #fafafa;
      color: #1a1a1a;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    .gc-wrap {
      background: #fff;
      border-radius: 20px;
      padding: 48px 40px;
      max-width: 540px;
      width: 100%;
      text-align: center;
      box-shadow: 0 8px 40px rgba(0,0,0,.08);
    }
    .gc-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 32px;
    }
    .gc-logo__text {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }
    .gc-gift-icon {
      font-size: 48px;
      margin-bottom: 16px;
      line-height: 1;
    }
    .gc-title {
      font-size: 28px;
      font-weight: 800;
      color: #1a1a1a;
      margin: 0 0 8px;
    }
    .gc-subtitle {
      color: #6b7280;
      font-size: 15px;
      margin: 0 0 32px;
    }
    .gc-value-card {
      background: linear-gradient(135deg, #FFF5F0, #FFE8DA);
      border-radius: 16px;
      padding: 32px;
      margin-bottom: 24px;
    }
    .gc-value-label {
      font-size: 13px;
      color: #E8621A;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .gc-value-amount {
      font-size: 48px;
      font-weight: 900;
      color: #E8621A;
      line-height: 1;
    }
    .gc-balance-note {
      font-size: 14px;
      color: #6b7280;
      margin-top: 12px;
    }
    .gc-code-card {
      background: #f9f9f9;
      border: 1.5px dashed #e5e7eb;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
    }
    .gc-code-label {
      font-size: 12px;
      color: #9ca3af;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 10px;
    }
    .gc-code {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 4px;
      color: #1a1a1a;
      font-family: 'Courier New', monospace;
      word-break: break-all;
    }
    .gc-expired {
      background: #fef2f2;
      color: #ef4444;
      border-radius: 8px;
      padding: 12px 20px;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 24px;
    }
    .gc-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: linear-gradient(135deg, #E8621A, #C44A1E);
      color: #fff;
      border: none;
      border-radius: 50px;
      padding: 16px 40px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: opacity .2s;
      margin-bottom: 20px;
    }
    .gc-btn:hover { opacity: .9; }
    .gc-help {
      font-size: 13px;
      color: #9ca3af;
      margin-top: 8px;
    }
    .gc-help a {
      color: #E8621A;
      font-weight: 600;
      text-decoration: underline;
    }
    .gc-print-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: 1.5px solid #e5e7eb;
      border-radius: 8px;
      padding: 8px 16px;
      font-size: 13px;
      color: #6b7280;
      cursor: pointer;
      margin-top: 16px;
      transition: border-color .2s;
    }
    .gc-print-btn:hover { border-color: #E8621A; color: #E8621A; }
    @media print {
      body { background: #fff; }
      .gc-btn, .gc-print-btn, .gc-help { display: none; }
    }
  </style>
</head>
<body>
  <div class="gc-wrap">

    <div class="gc-logo">
      <svg width="40" height="40" viewBox="0 0 96 96" fill="none">
        <circle cx="48" cy="48" r="47" fill="#E8621A"/>
        <text x="48" y="54" text-anchor="middle" fill="white" font-size="24" font-weight="900" font-family="Arial Black,Arial,sans-serif" letter-spacing="-0.5">ULTRA</text>
      </svg>
      <span class="gc-logo__text">belleza</span>
    </div>

    <div class="gc-gift-icon">🎁</div>
    <h1 class="gc-title">¡Tu regalo está aquí!</h1>
    <p class="gc-subtitle">Tarjeta de regalo ULTRA belleza — Lista para usar</p>

    <div class="gc-value-card">
      <p class="gc-value-label">Valor</p>
      <p class="gc-value-amount">{{ gift_card.initial_value | money }}</p>
      {% if gift_card.balance != gift_card.initial_value %}
        <p class="gc-balance-note">Saldo disponible: <strong style="color:#E8621A">{{ gift_card.balance | money }}</strong></p>
      {% endif %}
    </div>

    <div class="gc-code-card">
      <p class="gc-code-label">Código de tu tarjeta</p>
      <p class="gc-code">{{ gift_card.code | format_code }}</p>
    </div>

    {% if gift_card.expired or gift_card.enabled == false %}
      <div class="gc-expired">Esta tarjeta ha expirado o está desactivada.</div>
    {% endif %}

    <a href="{{ shop.url }}" class="gc-btn">
      Ir a la tienda →
    </a>

    <br>

    <button class="gc-print-btn" onclick="window.print()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Imprimir tarjeta
    </button>

    <p class="gc-help">
      ¿Necesitas ayuda?
      <a href="https://wa.me/{{ shop.metafields.custom.whatsapp_number | default: '573001234567' }}">Contáctanos por WhatsApp</a>
    </p>

  </div>
</body>
</html>
