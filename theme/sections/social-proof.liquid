<section class="section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background:{{ section.settings.bg_color }};">
  <div class="container">
    <div class="section-head section-head--center">
      {% if section.settings.eyebrow != blank %}
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.show_rating %}
        <div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-top:10px">
          <span style="color:#f59e0b;font-size:20px;letter-spacing:2px">★★★★★</span>
          <span style="font-size:14px;color:var(--text-muted);font-weight:600">{{ section.settings.rating_text }}</span>
        </div>
      {% endif %}
    </div>

    <div class="reviews-grid">
      {% for block in section.blocks %}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="review-stars">
            {% assign stars = block.settings.stars | default: 5 %}
            {% for i in (1..stars) %}★{% endfor %}
          </div>
          <p class="review-text">"{{ block.settings.text }}"</p>
          <div class="review-author">
            {% if block.settings.avatar != blank %}
              <img src="{{ block.settings.avatar | image_url: width: 80 }}" alt="{{ block.settings.name }}" width="36" height="36" style="border-radius:50%;object-fit:cover;flex-shrink:0">
            {% else %}
              <div class="review-avatar" style="background:{{ block.settings.color | default: '#E8621A' }}">
                {{ block.settings.name | slice: 0 }}
              </div>
            {% endif %}
            <div>
              <p class="review-name">{{ block.settings.name }}</p>
              <p class="review-meta">
                {% if block.settings.city != blank %}{{ block.settings.city }}{% endif %}
                {% if block.settings.city != blank and block.settings.product != blank %} · {% endif %}
                {% if block.settings.product != blank %}Compró: {{ block.settings.product }}{% endif %}
              </p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.cta_text != blank %}
      <div style="text-align:center;margin-top:40px">
        <a href="{{ section.settings.cta_url }}" class="hero-clean__btn-outline" style="display:inline-flex">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Reseñas / Testimonios",
  "settings": [
    { "type": "text",     "id": "eyebrow",     "label": "Texto eyebrow",         "default": "Testimonios reales" },
    { "type": "text",     "id": "title",       "label": "Título",                "default": "+10.000 mujeres ya confían en nosotras" },
    { "type": "checkbox", "id": "show_rating", "label": "Mostrar calificación global", "default": true },
    { "type": "text",     "id": "rating_text", "label": "Texto calificación",    "default": "4.9 / 5.0" },
    { "type": "text",     "id": "cta_text",    "label": "Texto botón (opcional)", "default": "" },
    { "type": "url",      "id": "cta_url",     "label": "Enlace del botón" },
    { "type": "color",    "id": "bg_color",    "label": "Color de fondo",        "default": "#ffffff" },
    { "type": "range",    "id": "padding_top",    "label": "Espacio superior", "min": 0, "max": 120, "step": 8, "default": 64 },
    { "type": "range",    "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 120, "step": 8, "default": 64 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "textarea",    "id": "text",    "label": "Texto de la reseña",  "default": "Increíble calidad y rapidez en el envío." },
        { "type": "range",       "id": "stars",   "label": "Estrellas",           "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text",        "id": "name",    "label": "Nombre del cliente",  "default": "Valentina M." },
        { "type": "text",        "id": "city",    "label": "Ciudad (opcional)",   "default": "Bogotá" },
        { "type": "text",        "id": "product", "label": "Producto comprado",   "default": "Sérum Vitamina C" },
        { "type": "image_picker","id": "avatar",  "label": "Foto del cliente (opcional)" },
        { "type": "color",       "id": "color",   "label": "Color avatar (si no hay foto)", "default": "#E8621A" }
      ]
    }
  ],
  "presets": [{
    "name": "Reseñas",
    "blocks": [
      { "type": "review", "settings": { "name": "Valentina M.", "city": "Bogotá",       "product": "Sérum Vitamina C", "color": "#E8621A", "text": "Increíble calidad y rapidez en el envío. ¡Ya hice mi segunda compra!" } },
      { "type": "review", "settings": { "name": "Camila R.",    "city": "Medellín",     "product": "Kit Capilar OGX",  "color": "#ef4444", "text": "Llevo 3 meses comprando aquí y nunca me han fallado." } },
      { "type": "review", "settings": { "name": "Daniela O.",   "city": "Cali",         "product": "Tónico Savar",     "color": "#8b5cf6", "text": "Por fin una tienda con dermocosméticos colombianos a buen precio." } },
      { "type": "review", "settings": { "name": "Luisa F.",     "city": "Barranquilla", "product": "Base L'Oréal",     "color": "#f59e0b", "text": "El maquillaje es 100% original. Muy profesionales y atentos." } }
    ]
  }]
}
{% endschema %}
