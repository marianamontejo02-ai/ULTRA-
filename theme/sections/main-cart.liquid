<div class="cart-page section-padding">
  <div class="container">
    <h1 class="cart-page-title">Tu carrito</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-page-layout">
          <div class="cart-page-items">
            {% for item in cart.items %}
              <div class="cart-page-item" data-key="{{ item.key }}">
                <a href="{{ item.url }}" class="cart-item-img-link">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" width="120" height="120" loading="lazy">
                  {% endif %}
                </a>
                <div class="cart-item-info">
                  <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
                  {% unless item.variant.title == 'Default Title' %}
                    <p class="cart-item-variant">{{ item.variant.title }}</p>
                  {% endunless %}
                  <p class="cart-item-vendor">{{ item.vendor }}</p>
                  <div class="cart-item-actions">
                    <div class="qty-selector">
                      <button type="button" class="qty-btn" onclick="updateCartItem('{{ item.key }}', {{ item.quantity | minus: 1 }})">−</button>
                      <span class="qty-value">{{ item.quantity }}</span>
                      <button type="button" class="qty-btn" onclick="updateCartItem('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
                    </div>
                    <button type="button" class="cart-item-remove" onclick="updateCartItem('{{ item.key }}', 0)" aria-label="Eliminar">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    </button>
                  </div>
                </div>
                <div class="cart-item-price">
                  {% if item.original_price > item.final_price %}
                    <s class="price-compare">{{ item.original_line_price | money }}</s>
                  {% endif %}
                  <span class="price{% if item.original_price > item.final_price %} price-sale{% endif %}">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            {% endfor %}
          </div>

          <div class="cart-page-summary">
            <div class="cart-summary-box">
              <h2 class="cart-summary-title">Resumen del pedido</h2>

              {% assign free_shipping_threshold = 150000 %}
              {% assign remaining = free_shipping_threshold | minus: cart.total_price %}
              {% if remaining > 0 %}
                <div class="cart-shipping-bar">
                  <p>Te faltan <strong>{{ remaining | money }}</strong> para envío gratis</p>
                  <div class="shipping-bar-track">
                    <div class="shipping-bar-fill" style="width: {{ cart.total_price | times: 100 | divided_by: free_shipping_threshold }}%"></div>
                  </div>
                </div>
              {% else %}
                <div class="cart-shipping-bar cart-shipping-bar--free">
                  <p>¡Tienes envío gratis! 🎉</p>
                </div>
              {% endif %}

              <div class="cart-summary-row">
                <span>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}producto{% else %}productos{% endif %})</span>
                <span>{{ cart.total_price | money }}</span>
              </div>
              <div class="cart-summary-row cart-summary-row--note">
                <span>Envío calculado al finalizar</span>
              </div>

              <div class="cart-summary-ctas">
                <a href="{{ routes.checkout_url }}" class="btn-primary btn-full">
                  Finalizar compra — {{ cart.total_price | money }}
                </a>
                <a href="{{ routes.root_url }}" class="btn-outline btn-full">Seguir comprando</a>
              </div>

              <div class="cart-trust-badges">
                <div class="trust-badge-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  Pago 100% seguro
                </div>
                <div class="trust-badge-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  Garantía de satisfacción
                </div>
                <div class="trust-badge-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  Envío a todo Colombia
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    {% else %}
      <div class="cart-empty-page">
        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ddd" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <h2>Tu carrito está vacío</h2>
        <p>¡Descubre nuestros productos y agrega los que más te gusten!</p>
        <a href="/collections/all" class="btn-primary">Ver productos</a>
      </div>
    {% endif %}
  </div>
</div>

<script>
function updateCartItem(key, qty) {
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: key, quantity: qty })
  }).then(() => window.location.reload());
}
</script>

{% schema %}
{
  "name": "Carrito",
  "settings": [],
  "presets": [{ "name": "Carrito" }]
}
{% endschema %}
