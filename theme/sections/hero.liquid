<section class="hero">
  <div class="hero__bg-circle"></div>
  <div class="hero__bg-circle2"></div>

  <div class="container">
    <div class="hero__content">
      <div class="hero__pill">
        <span class="hero__pill-dot"></span>
        {{ section.settings.pill_text }}
      </div>

      <h1 class="hero__title">
        {{ section.settings.title | replace: '[naranja]', '<mark>' | replace: '[/naranja]', '</mark>' }}
      </h1>

      <p class="hero__desc">{{ section.settings.subtitle }}</p>

      <div class="hero__btns">
        <a href="{{ section.settings.btn1_url }}" class="btn btn-primary btn-lg">
          {{ section.settings.btn1_text }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        {% if section.settings.btn2_text != blank %}
          <a href="{{ section.settings.btn2_url }}" class="btn btn-outline btn-lg">
            {{ section.settings.btn2_text }}
          </a>
        {% endif %}
      </div>

      <div class="hero__stats">
        {% for block in section.blocks %}
          <div class="hero__stat" {{ block.shopify_attributes }}>
            <div class="hero__stat-value">{{ block.settings.value }}</div>
            <div class="hero__stat-label">{{ block.settings.label }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="hero__trust">
    <div class="container">
      <div class="hero__trust-inner">
        {% assign trust_items = '🚚 Envío a todo Colombia,💳 Hasta 12 cuotas sin interés,🔄 Devoluciones fáciles,✅ Productos 100% originales,⚡ Despacho en 24h' | split: ',' %}
        {% for item in trust_items %}
          <span class="hero__trust-item">{{ item }}</span>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero principal",
  "settings": [
    { "type": "text", "id": "pill_text", "label": "Texto pastilla", "default": "✨ Nueva colección primavera-verano" },
    { "type": "text", "id": "title", "label": "Título (usa [naranja]...[/naranja] para color)", "default": "Tu belleza, [naranja]accesible[/naranja] y moderna." },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "default": "Maquillaje, cuidado capilar y dermocosméticos premium para mujeres colombianas que quieren verse arregladas sin gastar de más." },
    { "type": "text", "id": "btn1_text", "label": "Botón 1 texto", "default": "Ver productos" },
    { "type": "url",  "id": "btn1_url",  "label": "Botón 1 enlace" },
    { "type": "text", "id": "btn2_text", "label": "Botón 2 texto", "default": "🔥 Ver ofertas" },
    { "type": "url",  "id": "btn2_url",  "label": "Botón 2 enlace" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Estadística",
      "settings": [
        { "type": "text", "id": "value", "label": "Valor", "default": "+10.000" },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "clientas felices" }
      ]
    }
  ],
  "presets": [{
    "name": "Hero principal",
    "blocks": [
      { "type": "stat", "settings": { "value": "+10.000", "label": "clientas felices" } },
      { "type": "stat", "settings": { "value": "+500",    "label": "marcas y productos" } },
      { "type": "stat", "settings": { "value": "4.9★",   "label": "calificación promedio" } }
    ]
  }]
}
{% endschema %}
