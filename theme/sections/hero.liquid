<section class="hero-clean" id="hero-section">

  {% if section.settings.layout == 'split' %}
  <!-- ── Split layout: texto izquierda / imagen derecha ── -->
  <div class="hero-clean__split">

    <div class="hero-clean__text-col">
      <div class="hero-clean__text-wrap">
        {% if section.settings.eyebrow != blank %}
          <p class="hero-clean__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        <h1 class="hero-clean__title">
          {{ section.settings.title | replace: '[acento]', '<em>' | replace: '[/acento]', '</em>' }}
        </h1>

        {% if section.settings.subtitle != blank %}
          <p class="hero-clean__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}

        <div class="hero-clean__btns">
          {% if section.settings.btn1_text != blank %}
            <a href="{{ section.settings.btn1_url }}" class="hero-clean__btn-primary">
              {{ section.settings.btn1_text }}
            </a>
          {% endif %}
          {% if section.settings.btn2_text != blank %}
            <a href="{{ section.settings.btn2_url }}" class="hero-clean__btn-outline">
              {{ section.settings.btn2_text }}
            </a>
          {% endif %}
        </div>

        {% if section.blocks.size > 0 %}
          <div class="hero-clean__stats">
            {% for block in section.blocks %}
              <div class="hero-clean__stat" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.value }}</strong>
                <span>{{ block.settings.label }}</span>
              </div>
              {% unless forloop.last %}<div class="hero-clean__stat-sep"></div>{% endunless %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="hero-clean__img-col">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image_alt | default: shop.name }}"
          class="hero-clean__img"
          fetchpriority="high"
          width="1200" height="1400"
        >
      {% else %}
        <div class="hero-clean__img-placeholder"></div>
      {% endif %}
    </div>

  </div>

  {% else %}
  <!-- ── Full-bleed layout: imagen de fondo + texto encima ── -->
  <div class="hero-clean__fullbleed">

    {% if section.settings.image != blank %}
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        alt="{{ section.settings.image_alt | default: shop.name }}"
        class="hero-clean__bg-img"
        fetchpriority="high"
        width="1800" height="1000"
      >
    {% else %}
      <div class="hero-clean__bg-fallback"></div>
    {% endif %}

    <div class="hero-clean__overlay" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>

    <div class="container hero-clean__fullbleed-inner">
      <div class="hero-clean__text-wrap hero-clean__text-wrap--{{ section.settings.text_align }}">
        {% if section.settings.eyebrow != blank %}
          <p class="hero-clean__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        <h1 class="hero-clean__title hero-clean__title--light">
          {{ section.settings.title | replace: '[acento]', '<em>' | replace: '[/acento]', '</em>' }}
        </h1>

        {% if section.settings.subtitle != blank %}
          <p class="hero-clean__subtitle hero-clean__subtitle--light">{{ section.settings.subtitle }}</p>
        {% endif %}

        <div class="hero-clean__btns">
          {% if section.settings.btn1_text != blank %}
            <a href="{{ section.settings.btn1_url }}" class="hero-clean__btn-primary">
              {{ section.settings.btn1_text }}
            </a>
          {% endif %}
          {% if section.settings.btn2_text != blank %}
            <a href="{{ section.settings.btn2_url }}" class="hero-clean__btn-light">
              {{ section.settings.btn2_text }}
            </a>
          {% endif %}
        </div>

        {% if section.blocks.size > 0 %}
          <div class="hero-clean__stats hero-clean__stats--light">
            {% for block in section.blocks %}
              <div class="hero-clean__stat" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.value }}</strong>
                <span>{{ block.settings.label }}</span>
              </div>
              {% unless forloop.last %}<div class="hero-clean__stat-sep hero-clean__stat-sep--light"></div>{% endunless %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

  </div>
  {% endif %}

  <!-- Trust strip limpio -->
  {% if section.settings.show_trust %}
    <div class="hero-clean__trust">
      <div class="container">
        <ul class="hero-clean__trust-list">
          {% for block in section.blocks %}{% endfor %}
          <li>Envío a todo Colombia</li>
          <li class="trust-dot"></li>
          <li>Hasta 12 cuotas</li>
          <li class="trust-dot"></li>
          <li>Cambios en 30 días</li>
          <li class="trust-dot"></li>
          <li>Productos 100% originales</li>
        </ul>
      </div>
    </div>
  {% endif %}

</section>

{% schema %}
{
  "name": "Hero principal",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Diseño",
      "options": [
        { "value": "split",     "label": "Dividido — texto izquierda, imagen derecha" },
        { "value": "fullbleed", "label": "Imagen de fondo completa" }
      ],
      "default": "split"
    },
    { "type": "image_picker", "id": "image",     "label": "Imagen principal" },
    { "type": "text",         "id": "image_alt", "label": "Texto alternativo imagen", "default": "ULTRA belleza" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación del texto (solo modo fondo completo)",
      "options": [
        { "value": "left",   "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Oscuridad del overlay (solo fondo completo)",
      "min": 0, "max": 70, "step": 5, "default": 40,
      "unit": "%"
    },
    { "type": "text",     "id": "eyebrow",   "label": "Texto pequeño sobre el título",  "default": "Nueva colección" },
    { "type": "text",     "id": "title",     "label": "Título principal (usa [acento]...[/acento] para cursiva naranja)", "default": "Tu belleza, [acento]accesible[/acento] y moderna." },
    { "type": "textarea", "id": "subtitle",  "label": "Subtítulo",   "default": "Maquillaje, cuidado capilar y dermocosméticos para mujeres colombianas." },
    { "type": "text",     "id": "btn1_text", "label": "Botón principal — texto",  "default": "Ver productos" },
    { "type": "url",      "id": "btn1_url",  "label": "Botón principal — enlace" },
    { "type": "text",     "id": "btn2_text", "label": "Botón secundario — texto",  "default": "Ver ofertas" },
    { "type": "url",      "id": "btn2_url",  "label": "Botón secundario — enlace" },
    { "type": "checkbox", "id": "show_trust","label": "Mostrar barra de confianza", "default": true }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Estadística",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Número o valor", "default": "+10.000" },
        { "type": "text", "id": "label", "label": "Descripción",    "default": "clientas felices" }
      ]
    }
  ],
  "presets": [{
    "name": "Hero principal",
    "settings": { "layout": "split" },
    "blocks": [
      { "type": "stat", "settings": { "value": "+10.000", "label": "clientas felices" } },
      { "type": "stat", "settings": { "value": "+500",    "label": "productos" } },
      { "type": "stat", "settings": { "value": "4.9",     "label": "calificación" } }
    ]
  }]
}
{% endschema %}
