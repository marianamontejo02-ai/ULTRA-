<footer class="site-footer" role="contentinfo">
  <!-- Newsletter -->
  <div class="footer-newsletter">
    <div class="container">
      <h3>Únete a la comunidad ULTRA belleza</h3>
      <p>Suscríbete y recibe un <strong>10% de descuento</strong> en tu primera compra + novedades y ofertas exclusivas.</p>
      {% form 'customer' %}
        <div class="newsletter-form">
          <input
            type="email"
            name="contact[email]"
            class="newsletter-input"
            placeholder="tu@correo.com"
            required
            aria-label="Tu correo electronico"
          >
          <button type="submit" class="newsletter-btn">Quiero mi descuento</button>
        </div>
      {% endform %}
    </div>
  </div>

  <!-- Main -->
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">
        <!-- Brand column -->
        <div>
          <div class="footer-brand__logo">
            <svg width="36" height="36" viewBox="0 0 96 96" fill="none">
              <circle cx="48" cy="48" r="47" fill="#E8621A"/>
              <text x="48" y="54" text-anchor="middle" fill="white" font-size="26" font-weight="900" font-family="Arial Black, Arial, sans-serif">ULTRA</text>
            </svg>
            belleza
          </div>
          <p class="footer-brand__desc">
            Tu tienda de belleza accesible y moderna. Maquillaje, capilar y cuidado personal para mujeres colombianas que quieren verse increíbles sin gastar de más.
          </p>
          <div class="footer-socials">
            <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" class="footer-social-btn" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="{{ section.settings.facebook }}" target="_blank" rel="noopener" class="footer-social-btn" aria-label="Facebook">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" class="footer-social-btn" aria-label="WhatsApp">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          </div>
        </div>

        <!-- Tienda -->
        <div>
          <p class="footer-col-title">Tienda</p>
          <a href="/collections/capilar"          class="footer-link">Cuidado Capilar</a>
          <a href="/collections/maquillaje"        class="footer-link">Maquillaje</a>
          <a href="/collections/dermocosmeticos"   class="footer-link">Dermocosméticos</a>
          <a href="/collections/skin-care"         class="footer-link">Skin Care</a>
          <a href="/collections/novedades"         class="footer-link">Novedades</a>
          <a href="/collections/ofertas"           class="footer-link">Ofertas</a>
        </div>

        <!-- Información -->
        <div>
          <p class="footer-col-title">Información</p>
          <a href="/pages/nosotras"      class="footer-link">Sobre nosotras</a>
          <a href="/policies/shipping"   class="footer-link">Políticas de envío</a>
          <a href="/policies/refund"     class="footer-link">Devoluciones</a>
          <a href="/pages/faq"           class="footer-link">Preguntas frecuentes</a>
          <a href="/policies/terms"      class="footer-link">Términos y condiciones</a>
          <a href="/policies/privacy"    class="footer-link">Política de privacidad</a>
        </div>

        <!-- Contacto -->
        <div>
          <p class="footer-col-title">Contacto</p>
          <div class="footer-contact-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Colombia — Envíos a todo el país
          </div>
          <div class="footer-contact-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <a href="https://wa.me/{{ settings.whatsapp_number }}">WhatsApp: +57 {{ settings.whatsapp_number | slice: 2, 10 }}</a>
          </div>
          <div class="footer-contact-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </div>
          <div class="footer-contact-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Lun–Sáb: 8am – 6pm
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom -->
  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-inner">
        <p class="footer-copyright">© {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</p>
        <div class="footer-payments">
          {% assign payment_methods = 'Visa,Mastercard,PSE,Nequi,Bancolombia,Efecty' | split: ',' %}
          {% for method in payment_methods %}
            <span class="payment-badge">{{ method }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "text", "id": "email",     "label": "Email de contacto", "default": "hola@ultra.com.co" },
    { "type": "url",  "id": "instagram", "label": "Instagram URL" },
    { "type": "url",  "id": "facebook",  "label": "Facebook URL" }
  ]
}
{% endschema %}
