<div class="brand-bar">
  <p class="brand-bar__label">Marcas que amamos y distribuimos</p>
  <div class="brand-bar__overflow">
    <div class="brand-bar__track">

      {% capture brands_raw %}Anyeluz|🇨🇴|anyeluz
Recamier|🇨🇴|recamier
Vogue|🇨🇴|vogue
Milagros|🇨🇴|milagros
Montoc|🇨🇴|montoc
La Poción|🇨🇴|la-pocion
La Receta|🇨🇴|la-receta
Leche Pal Pelo|🇨🇴|leche-pal-pelo
Olé|🇨🇴|ole
Brujería|🇨🇴|brujeria
Byspro|🇨🇴|byspro
Corbeta|🇨🇴|corbeta
Kaba|🇨🇴|kaba
Kaloe|🇨🇴|kaloe
Lehit|🇨🇴|lehit
Melu|🇨🇴|melu
Meycis|🇨🇴|meycis
Nude|🇨🇴|nude
Origen Botánico|🇨🇴|origen-botanico
Pili|🇨🇴|pili
Prokapil|🇨🇴|prokapil
Prokpil|🇨🇴|prokpil
Smart|🇨🇴|smart
Trendy|🇨🇴|trendy
Ame|🇨🇴|ame
Anik|🇨🇴|anik
Belotti|🇨🇴|belotti
Ponto|🇨🇴|ponto
Atenea|🇨🇴|atenea
L'Oréal|🇫🇷|loreal
Garnier|🇫🇷|garnier
Maybelline|🇺🇸|maybelline
Ruby Rose|🇨🇴|ruby-rose
Skala|🇧🇷|skala
Samy|🇨🇴|samy
Nutribela|🇨🇴|nutribela{% endcapture %}

      {% assign brand_rows = brands_raw | split: "
" %}

      {% comment %} Primera pasada (para el ticker infinito duplicamos) {% endcomment %}
      {% for pass in (1..2) %}
        {% for row in brand_rows %}
          {% assign row_clean = row | strip %}
          {% if row_clean != '' %}
            {% assign parts = row_clean | split: '|' %}
            {% assign b_name   = parts[0] %}
            {% assign b_flag   = parts[1] %}
            {% assign b_handle = parts[2] %}
            <a href="/collections/{{ b_handle }}" class="brand-bar__item">
              <span class="brand-bar__flag">{{ b_flag }}</span>
              <span class="brand-bar__name">{{ b_name }}</span>
            </a>
          {% endif %}
        {% endfor %}
      {% endfor %}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Barra de marcas",
  "settings": [],
  "presets": [{ "name": "Barra de marcas" }]
}
{% endschema %}
