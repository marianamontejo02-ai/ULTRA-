<div class="coll-page">
  <div class="container">

    <nav class="breadcrumb" aria-label="Ruta">
      <a href="{{ routes.root_url }}">Inicio</a>
      <span>/</span>
      <span>{{ collection.title }}</span>
    </nav>

    <div class="coll-page__head">
      <h1 class="coll-page__title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <p class="coll-page__desc">{{ collection.description }}</p>
      {% endif %}
    </div>

    <div class="coll-layout">

      <!-- Sidebar -->
      <aside class="coll-sidebar" id="coll-sidebar">
        <div class="coll-sidebar__head">
          <span class="coll-sidebar__title">Filtrar</span>
          <button class="coll-sidebar__clear" id="clear-filters-btn">Limpiar</button>
        </div>

        {% assign vendors = collection.products | map: 'vendor' | uniq | sort %}
        {% if vendors.size > 0 %}
          <div class="filter-group">
            <button class="filter-group__toggle" aria-expanded="true">
              Marca
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="filter-group__body">
              {% for vendor in vendors %}
                {% unless vendor == 'My Store' or vendor == blank %}
                  <label class="filter-check">
                    <input type="checkbox" class="filter-vendor-cb" value="{{ vendor }}">
                    <span class="filter-check__box"></span>
                    <span class="filter-check__label">{{ vendor }}</span>
                  </label>
                {% endunless %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <div class="filter-group">
          <button class="filter-group__toggle" aria-expanded="true">
            Precio
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="filter-group__body">
            <label class="filter-check"><input type="checkbox" class="filter-price-cb" value="0-40000"><span class="filter-check__box"></span><span class="filter-check__label">Menos de $40.000</span></label>
            <label class="filter-check"><input type="checkbox" class="filter-price-cb" value="0-60000"><span class="filter-check__box"></span><span class="filter-check__label">Menos de $60.000</span></label>
          </div>
        </div>
      </aside>

      <!-- Main -->
      <div class="coll-main">
        <div class="coll-toolbar">
          <div class="coll-toolbar__left">
            <button class="coll-filter-toggle" id="filter-toggle-btn" aria-expanded="false">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
              Filtros
            </button>
            <span class="coll-count">{{ collection.products_count }} productos</span>
          </div>
          <div class="coll-toolbar__right">
            <label class="coll-sort-label" for="sort-select">Ordenar:</label>
            <select id="sort-select" class="coll-sort-select">
              <option value="featured">Destacados</option>
              <option value="best-selling">Más vendidos</option>
              <option value="price-ascending">Precio: menor a mayor</option>
              <option value="price-descending">Precio: mayor a menor</option>
              <option value="created-descending">Más recientes</option>
              <option value="title-ascending">A–Z</option>
            </select>
          </div>
        </div>

        {% paginate collection.products by 24 %}
          <div class="pcard-grid" id="product-grid">
            {% for product in collection.products %}
              {% render 'product-card', card_product: product %}
            {% else %}
              <p class="coll-empty">Esta colección no tiene productos aún.</p>
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <nav class="pagination" aria-label="Paginación">
              {% if paginate.previous %}<a href="{{ paginate.previous.url }}" class="page-btn">← Anterior</a>{% endif %}
              {% for part in paginate.parts %}
                {% if part.is_link %}<a href="{{ part.url }}" class="page-btn">{{ part.title }}</a>
                {% elsif part.title == paginate.current_page %}<span class="page-btn page-btn--active">{{ part.title }}</span>
                {% else %}<span class="page-btn page-btn--gap">…</span>{% endif %}
              {% endfor %}
              {% if paginate.next %}<a href="{{ paginate.next.url }}" class="page-btn">Siguiente →</a>{% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</div>

<script>
// Restaurar estado de checkboxes al cargar
(function() {
  var params = new URLSearchParams(window.location.search);
  // Marcas activas
  var activeVendors = params.getAll('filter.p.vendor');
  document.querySelectorAll('.filter-vendor-cb').forEach(function(cb) {
    if (activeVendors.includes(cb.value)) cb.checked = true;
  });
  // Precio activo
  var priceLte = params.get('filter.v.price.lte');
  if (priceLte) {
    document.querySelectorAll('.filter-price-cb').forEach(function(cb) {
      if (cb.value === '0-' + priceLte) cb.checked = true;
    });
  }
})();

// Ordenar
document.getElementById('sort-select')?.addEventListener('change', function() {
  var url = new URL(window.location.href);
  url.searchParams.set('sort_by', this.value);
  window.location.href = url.toString();
});

// Filtro por marca — selección múltiple
document.querySelectorAll('.filter-vendor-cb').forEach(function(cb) {
  cb.addEventListener('change', function() {
    var checked = Array.from(document.querySelectorAll('.filter-vendor-cb:checked')).map(function(c){ return c.value; });
    var url = new URL(window.location.href);
    url.searchParams.delete('filter.p.vendor');
    checked.forEach(function(v) { url.searchParams.append('filter.p.vendor', v); });
    window.location.href = url.toString();
  });
});

// Filtro por precio — solo una opción a la vez
document.querySelectorAll('.filter-price-cb').forEach(function(cb) {
  cb.addEventListener('change', function() {
    // Desmarcar las demás opciones de precio
    document.querySelectorAll('.filter-price-cb').forEach(function(other) {
      if (other !== cb) other.checked = false;
    });
    var url = new URL(window.location.href);
    url.searchParams.delete('filter.v.price.gte');
    url.searchParams.delete('filter.v.price.lte');
    if (cb.checked) {
      var parts = cb.value.split('-');
      url.searchParams.set('filter.v.price.gte', parts[0]);
      url.searchParams.set('filter.v.price.lte', parts[1]);
    }
    window.location.href = url.toString();
  });
});

// Abrir/cerrar grupos de filtros
document.querySelectorAll('.filter-group__toggle').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    btn.nextElementSibling.classList.toggle('collapsed', expanded);
    btn.classList.toggle('collapsed', expanded);
  });
});

// Sidebar en móvil
document.getElementById('filter-toggle-btn')?.addEventListener('click', function() {
  document.getElementById('coll-sidebar').classList.toggle('open');
  this.setAttribute('aria-expanded', document.getElementById('coll-sidebar').classList.contains('open'));
});

// Limpiar todos los filtros
document.getElementById('clear-filters-btn')?.addEventListener('click', function() {
  window.location.href = window.location.pathname;
});
</script>

{% schema %}
{
  "name": "Página de colección",
  "settings": [],
  "presets": [{ "name": "Página de colección" }]
}
{% endschema %}
