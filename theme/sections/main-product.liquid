<div class="container" style="padding-top:32px;padding-bottom:64px">
  <nav class="breadcrumb">
    <a href="{{ routes.root_url }}">Inicio</a>
    <span>/</span>
    {% if product.collections.first %}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      <span>/</span>
    {% endif %}
    <span>{{ product.title }}</span>
  </nav>

  <div class="product-layout">
    <!-- Gallery -->
    <div class="product-gallery-wrap">
      <div class="product-gallery__main" id="gallery-main-wrap">
        <img
          id="gallery-main-img"
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="900" height="900"
        >
        {% assign first_variant = product.selected_or_first_available_variant %}
        {% if first_variant.compare_at_price > first_variant.price %}
          {% assign disc = first_variant.compare_at_price | minus: first_variant.price | times: 100 | divided_by: first_variant.compare_at_price | round %}
          <div class="product-gallery__badge">
            <span class="badge badge-sale">-{{ disc }}%</span>
          </div>
        {% endif %}
        <!-- Zoom hint -->
        <div class="gallery-zoom-hint">🔍 Click para ampliar</div>
      </div>

      {% if product.images.size > 1 %}
        <div class="product-gallery__thumbs" id="gallery-thumbs">
          {% for image in product.images %}
            <div
              class="product-gallery__thumb {% if forloop.first %}active{% endif %}"
              data-src="{{ image | image_url: width: 900 }}"
              data-index="{{ forloop.index0 }}"
            >
              <img
                src="{{ image | image_url: width: 160 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                width="160" height="160"
                loading="lazy"
              >
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Info -->
    <div class="product-info">
      <p class="product-info__vendor">{{ product.vendor }}</p>
      <h1 class="product-info__title">{{ product.title }}</h1>

      <div class="product-info__stars">
        <span class="product-info__stars-icons">★★★★★</span>
        <span class="product-info__stars-count">4.8 (127 reseñas)</span>
      </div>

      <!-- Price -->
      <div class="product-price" id="product-price-block">
        <span id="product-price" class="product-price__current {% if first_variant.compare_at_price > first_variant.price %}sale{% endif %}">
          {{ first_variant.price | money }}
        </span>
        {% if first_variant.compare_at_price > first_variant.price %}
          <span id="product-compare-price" class="product-price__compare">{{ first_variant.compare_at_price | money }}</span>
          {% assign disc2 = first_variant.compare_at_price | minus: first_variant.price | times: 100 | divided_by: first_variant.compare_at_price | round %}
          <span class="badge badge-sale" id="product-disc-badge">Ahorras {{ disc2 }}%</span>
        {% else %}
          <span id="product-compare-price" style="display:none" class="product-price__compare"></span>
          <span id="product-disc-badge" style="display:none" class="badge badge-sale"></span>
        {% endif %}
      </div>

      <!-- Dynamic buyers bar -->
      <div class="pdp-live-bar">
        <div class="pdp-live-dot"></div>
        <span id="pdp-buyers-text">
          <strong id="pdp-buyers-num">{{ 'now' | date: '%s' | modulo: 18 | plus: 9 }}</strong>
          personas están comprando esto ahora
        </span>
      </div>

      <!-- Urgency -->
      {% if first_variant.inventory_quantity <= 10 and first_variant.inventory_quantity > 0 %}
        <div class="urgency-bar urgency-bar--pulse">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          ¡Solo quedan <strong>{{ first_variant.inventory_quantity }} unidades</strong> en stock!
        </div>
      {% endif %}

      <form id="product-form" method="post" action="{{ routes.cart_add_url }}" enctype="multipart/form-data">
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" id="variant-id" name="id" value="{{ first_variant.id }}">

        <script id="product-variants-json" type="application/json">
          {{ product.variants | json }}
        </script>
        <script id="product-images-json" type="application/json">
          [{% for image in product.images %}{"id":{{ image.id }},"src":"{{ image | image_url: width: 900 }}","alt":"{{ image.alt | default: product.title | escape }}"}{% unless forloop.last %},{% endunless %}{% endfor %}]
        </script>

        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            {% assign opt_lower = option.name | downcase %}
            {% assign is_color = false %}
            {% if opt_lower == 'color' or opt_lower == 'tono' or opt_lower == 'shade' or opt_lower == 'color/tono' %}
              {% assign is_color = true %}
            {% endif %}
            {% assign is_size = false %}
            {% if opt_lower == 'tamaño' or opt_lower == 'tamano' or opt_lower == 'size' or opt_lower == 'ml' or opt_lower == 'gr' or opt_lower == 'presentación' %}
              {% assign is_size = true %}
            {% endif %}

            <div class="variant-option" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name }}">
              <div class="variant-option__label">
                <span>{{ option.name }}</span>
                <span class="variant-selected-value" id="selected-{{ option.name | handleize }}">{{ option.selected_value }}</span>
              </div>

              {% if is_color %}
                <!-- Color swatch selector -->
                <div class="swatch-grid" data-option-position="{{ forloop.index }}">
                  {% for value in option.values %}
                    <button
                      type="button"
                      class="swatch-btn {% if option.selected_value == value %}active{% endif %}"
                      data-value="{{ value }}"
                      data-option-position="{{ forloop.index }}"
                      title="{{ value }}"
                    >
                      <span class="swatch-color" style="background:{{ value | handleize | replace: '-', '' }}"></span>
                      <span class="swatch-label">{{ value }}</span>
                    </button>
                  {% endfor %}
                </div>
              {% elsif is_size %}
                <!-- Size/volume pill selector -->
                <div class="size-pill-row" data-option-position="{{ forloop.index }}">
                  {% for value in option.values %}
                    <button
                      type="button"
                      class="size-pill {% if option.selected_value == value %}active{% endif %}"
                      data-value="{{ value }}"
                      data-option-position="{{ forloop.index }}"
                    >{{ value }}</button>
                  {% endfor %}
                </div>
              {% else %}
                <!-- Generic buttons -->
                <div class="variant-buttons" data-option-position="{{ forloop.index }}">
                  {% for value in option.values %}
                    <button
                      type="button"
                      class="variant-btn {% if option.selected_value == value %}active{% endif %}"
                      data-value="{{ value }}"
                      data-option-position="{{ forloop.index }}"
                    >{{ value }}</button>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% endunless %}

        <!-- Quantity -->
        <div class="qty-row">
          <label class="qty-label">Cantidad</label>
          <div class="qty-selector qty-selector--lg">
            <button type="button" class="qty-btn" id="qty-minus">−</button>
            <input type="number" name="quantity" id="product-qty" value="1" min="1" max="99" class="qty-input" aria-label="Cantidad">
            <button type="button" class="qty-btn" id="qty-plus">+</button>
          </div>
        </div>

        <!-- Add to cart -->
        <div class="add-to-cart-section">
          <button
            id="add-to-cart-btn"
            type="button"
            class="add-to-cart-btn"
            data-add-to-cart
            {% unless product.available %}disabled{% endunless %}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            {% if product.available %}Agregar al carrito{% else %}Producto agotado{% endif %}
          </button>

          <button type="button" class="buy-now-btn" id="buy-now-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            Comprar ahora
          </button>
        </div>
      </form>

      <!-- Guarantees -->
      <div class="product-guarantees">
        <div class="guarantee-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <strong>Envío Colombia</strong>
          <span>Despacho en 24h</span>
        </div>
        <div class="guarantee-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
          <strong>Devoluciones</strong>
          <span>30 días, fácil</span>
        </div>
        <div class="guarantee-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <strong>100% Original</strong>
          <span>Garantía autenticidad</span>
        </div>
      </div>

      <p class="payment-note">💳 Paga con Visa, Mastercard, Nequi, PSE, Bancolombia o Efecty</p>

      <div class="accordion">
        {% if product.description != blank %}
          <div class="accordion-item">
            <button class="accordion-trigger" type="button">
              Descripción del producto
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="accordion-content">{{ product.description }}</div>
          </div>
        {% endif %}
        <div class="accordion-item">
          <button class="accordion-trigger" type="button">
            Modo de uso
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="accordion-content"><p>Aplica según las indicaciones del producto. Para mejores resultados, úsalo en tu rutina diaria de belleza.</p></div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger" type="button">
            Envío y devoluciones
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="accordion-content"><p>Enviamos a todo Colombia en 2-5 días hábiles. Envío gratis en compras desde $150.000. Devoluciones aceptadas en 30 días.</p></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Related products -->
  {% if recommendations.performed and recommendations.products_count > 0 %}
    <div style="margin-top:64px;padding-top:48px;border-top:1px solid var(--border)">
      <h2 class="section-title" style="margin-bottom:28px">Completa tu rutina</h2>
      <div class="products-grid">
        {% for rec in recommendations.products limit: 4 %}
          {% render 'product-card', card_product: rec %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

<script>
// Quantity controls
document.getElementById('qty-minus')?.addEventListener('click', function() {
  var inp = document.getElementById('product-qty');
  if (parseInt(inp.value) > 1) inp.value = parseInt(inp.value) - 1;
});
document.getElementById('qty-plus')?.addEventListener('click', function() {
  var inp = document.getElementById('product-qty');
  inp.value = parseInt(inp.value) + 1;
});

// Buy now button
document.getElementById('buy-now-btn')?.addEventListener('click', function() {
  var varId = document.getElementById('variant-id').value;
  var qty   = parseInt(document.getElementById('product-qty').value) || 1;
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: parseInt(varId), quantity: qty })
  }).then(function() { window.location.href = '/checkout'; });
});

// Dynamic buyers counter fluctuation
(function() {
  var el = document.getElementById('pdp-buyers-num');
  if (!el) return;
  var base = parseInt(el.textContent, 10) || 12;
  setInterval(function() {
    var delta = Math.floor(Math.random() * 3) - 1;
    base = Math.max(5, Math.min(base + delta, 40));
    el.textContent = base;
  }, 8000);
})();
</script>

{% schema %}
{
  "name": "Página de producto",
  "settings": [],
  "presets": [{ "name": "Página de producto" }]
}
{% endschema %}
