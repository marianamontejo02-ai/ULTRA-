<section class="section fp-section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background:{{ section.settings.bg_color }};">
  <div class="container">

    <div class="section-head section-head--split">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="section-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="section-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_url }}" class="see-all-link">
          {{ section.settings.btn_text }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      {% endif %}
    </div>

    {% comment %}
      Fuente de productos:
      1. Colección elegida en el selector
      2. Si no hay colección: muestra todos los productos de la tienda
    {% endcomment %}
    {% if section.settings.collection != blank %}
      {% assign product_list = collections[section.settings.collection].products %}
    {% else %}
      {% assign product_list = collections.all.products %}
    {% endif %}

    {% if section.settings.scroll_mode %}
      <!-- Modo scroll horizontal (como Ulta "trending") -->
      <div class="fp-scroll-wrap">
        <div class="fp-scroll-track">
          {% for product in product_list limit: section.settings.products_count %}
            {% render 'product-card', card_product: product %}
          {% else %}
            <p class="fp-empty">Agrega productos o selecciona una colección para que aparezcan aquí.</p>
          {% endfor %}
        </div>
        <button class="fp-scroll-btn fp-scroll-btn--prev" aria-label="Anterior">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="fp-scroll-btn fp-scroll-btn--next" aria-label="Siguiente">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    {% else %}
      <!-- Modo grilla normal -->
      <div class="pcard-grid pcard-grid--home">
        {% for product in product_list limit: section.settings.products_count %}
          {% render 'product-card', card_product: product %}
        {% else %}
          <p class="fp-empty" style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted)">
            Selecciona una colección en la configuración de esta sección para mostrar productos.
          </p>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.cta_text != blank %}
      <div class="fp-cta-wrap">
        <a href="{{ section.settings.cta_url }}" class="fp-cta-btn">{{ section.settings.cta_text }}</a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Productos destacados",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado de la sección"
    },
    { "type": "text",   "id": "eyebrow",   "label": "Texto pequeño (eyebrow)",    "default": "Lo más vendido" },
    { "type": "text",   "id": "title",     "label": "Título",                     "default": "Más vendidos" },
    { "type": "text",   "id": "subtitle",  "label": "Subtítulo",                  "default": "Los favoritos de nuestra comunidad" },
    { "type": "text",   "id": "btn_text",  "label": "Texto del enlace 'Ver todo'", "default": "Ver todos" },
    { "type": "url",    "id": "btn_url",   "label": "Enlace del botón 'Ver todo'" },
    {
      "type": "header",
      "content": "Productos"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección de productos",
      "info": "Si no seleccionas ninguna, se muestran todos los productos de la tienda"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Cantidad de productos",
      "min": 2, "max": 16, "step": 1, "default": 8
    },
    {
      "type": "checkbox",
      "id": "scroll_mode",
      "label": "Modo scroll horizontal (tipo carrusel)",
      "default": false
    },
    {
      "type": "header",
      "content": "Botón inferior (opcional)"
    },
    { "type": "text", "id": "cta_text", "label": "Texto del botón", "default": "" },
    { "type": "url",  "id": "cta_url",  "label": "Enlace del botón" },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    { "type": "range", "id": "padding_top",    "label": "Espacio superior (px)", "min": 0, "max": 120, "step": 8, "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 120, "step": 8, "default": 64 }
  ],
  "presets": [{ "name": "Productos destacados" }]
}
{% endschema %}
