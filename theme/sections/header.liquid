{% assign brands_capilar    = 'Anyeluz,Atenea,Montoc,Milagros,OGX,Pantene,Sedal,Tío Nacho,Wella' | split: ',' %}
{% assign brands_maquillaje = "Anyeluz,Atenea,Milagros,L'Oréal,Revlon,Maybelline,NYX,Rimmel" | split: ',' %}
{% assign brands_dermos     = 'Anyeluz,Atenea,Montoc,Milagros,Weleda,Savar,Natura,Payot' | split: ',' %}

<header class="site-header" id="site-header" role="banner">

  <!-- ── Fila 1: Logo · Búsqueda · Iconos ─────────────────── -->
  <div class="header-main">
    <div class="container header-main__inner">

      <!-- Hamburger (mobile) -->
      <button id="menu-toggle" class="hdr-icon-btn" aria-label="Menú" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="hdr-logo" aria-label="{{ shop.name }}">
        <svg width="38" height="38" viewBox="0 0 96 96" fill="none">
          <circle cx="48" cy="48" r="47" fill="#E8621A"/>
          <text x="48" y="54" text-anchor="middle" fill="white" font-size="28" font-weight="900" font-family="Arial Black, Arial, sans-serif" letter-spacing="-0.5">ULTRA</text>
          <g transform="translate(14,0) scale(0.72) translate(0,-62)">
            <circle cx="31" cy="68" r="4" fill="white" opacity=".9"/><circle cx="31" cy="68" r="1.8" fill="#E8621A"/>
            <circle cx="39" cy="68" r="4" fill="white" opacity=".9"/><circle cx="39" cy="68" r="1.8" fill="#E8621A"/>
            <circle cx="57" cy="68" r="4" fill="white" opacity=".9"/><circle cx="57" cy="68" r="1.8" fill="#E8621A"/>
            <circle cx="65" cy="68" r="4" fill="white" opacity=".9"/><circle cx="65" cy="68" r="1.8" fill="#E8621A"/>
            <circle cx="35" cy="76" r="4" fill="white" opacity=".9"/><circle cx="35" cy="76" r="1.8" fill="#E8621A"/>
            <circle cx="43" cy="76" r="4" fill="white" opacity=".9"/><circle cx="43" cy="76" r="1.8" fill="#E8621A"/>
            <circle cx="53" cy="76" r="4" fill="white" opacity=".9"/><circle cx="53" cy="76" r="1.8" fill="#E8621A"/>
            <circle cx="61" cy="76" r="4" fill="white" opacity=".9"/><circle cx="61" cy="76" r="1.8" fill="#E8621A"/>
            <circle cx="35" cy="84" r="4" fill="white" opacity=".9"/><circle cx="35" cy="84" r="1.8" fill="#E8621A"/>
            <circle cx="48" cy="84" r="4" fill="white" opacity=".9"/><circle cx="48" cy="84" r="1.8" fill="#E8621A"/>
            <circle cx="61" cy="84" r="4" fill="white" opacity=".9"/><circle cx="61" cy="84" r="1.8" fill="#E8621A"/>
            <circle cx="39" cy="92" r="4" fill="white" opacity=".9"/><circle cx="39" cy="92" r="1.8" fill="#E8621A"/>
            <circle cx="48" cy="92" r="4" fill="white" opacity=".9"/><circle cx="48" cy="92" r="1.8" fill="#E8621A"/>
            <circle cx="57" cy="92" r="4" fill="white" opacity=".9"/><circle cx="57" cy="92" r="1.8" fill="#E8621A"/>
            <circle cx="48" cy="100" r="4" fill="white" opacity=".9"/><circle cx="48" cy="100" r="1.8" fill="#E8621A"/>
          </g>
        </svg>
        <span class="hdr-logo__text">belleza</span>
      </a>

      <!-- Search bar -->
      <form class="hdr-search" action="{{ routes.search_url }}" method="get" role="search">
        <input
          type="search"
          name="q"
          class="hdr-search__input"
          placeholder="Busca productos, marcas o categorías..."
          autocomplete="off"
          aria-label="Buscar"
        >
        <input type="hidden" name="type" value="product">
        <button type="submit" class="hdr-search__btn" aria-label="Buscar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>

      <!-- Icons: solo carrito -->
      <div class="hdr-icons">
        <button id="cart-toggle" class="hdr-icon-btn hdr-cart-btn" aria-label="Carrito">
          <div class="hdr-cart-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span class="cart-count" style="display:none">0</span>
          </div>
          <span class="hdr-icon-label">Bolsa</span>
        </button>
      </div>

    </div>
  </div>

  <!-- ── Fila 2: Nav desde menú de Shopify ────────────────── -->
  <nav class="hdr-nav" role="navigation" aria-label="Categorías">
    <div class="container hdr-nav__inner">

      {% for link in linklists.main-menu.links %}
        {% assign link_url_lower = link.url | downcase %}

        {% if link.links != blank %}
          <!-- Item con mega menú desplegable -->
          <div class="hdr-nav__item">
            <a href="{{ link.url }}" class="hdr-nav__link {% if link.active %}active{% endif %}">{{ link.title }}</a>
            <div class="hdr-mega">
              <div class="hdr-mega__inner container">

                <!-- Columna de marcas (según URL de la categoría) -->
                <div class="hdr-mega__col">
                  <p class="hdr-mega__label">Por marca</p>
                  {% if link_url_lower contains 'maquillaje' %}
                    {% for brand in brands_maquillaje %}
                      <a href="{{ link.url }}?filter.p.vendor={{ brand | url_encode }}" class="hdr-mega__link">{{ brand }}</a>
                    {% endfor %}
                  {% elsif link_url_lower contains 'capilar' %}
                    {% for brand in brands_capilar %}
                      <a href="{{ link.url }}?filter.p.vendor={{ brand | url_encode }}" class="hdr-mega__link">{{ brand }}</a>
                    {% endfor %}
                  {% elsif link_url_lower contains 'dermo' %}
                    {% for brand in brands_dermos %}
                      <a href="{{ link.url }}?filter.p.vendor={{ brand | url_encode }}" class="hdr-mega__link">{{ brand }}</a>
                    {% endfor %}
                  {% else %}
                    {% for child_link in link.links %}
                      <a href="{{ child_link.url }}" class="hdr-mega__link">{{ child_link.title }}</a>
                    {% endfor %}
                  {% endif %}
                </div>

                <!-- Columna de subcategorías (desde los ítems hijo del menú) -->
                <div class="hdr-mega__col">
                  <p class="hdr-mega__label">Categorías</p>
                  {% for child_link in link.links %}
                    <a href="{{ child_link.url }}" class="hdr-mega__link">{{ child_link.title }}</a>
                  {% endfor %}
                </div>

                <div class="hdr-mega__promo">
                  <a href="{{ link.url }}" class="hdr-mega__promo-link">
                    Ver todo {{ link.title }}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                </div>

              </div>
            </div>
          </div>

        {% else %}
          <!-- Link simple (sin subcategorías) -->
          <a
            href="{{ link.url }}"
            class="hdr-nav__link {% if link_url_lower contains 'oferta' %}hdr-nav__link--sale{% endif %} {% if link.active %}active{% endif %}"
          >{{ link.title }}</a>
        {% endif %}

      {% endfor %}

    </div>
  </nav>

  <!-- ── Mobile menu ───────────────────────────────────────── -->
  <div id="mobile-menu" class="mobile-menu" role="dialog" aria-label="Menú">
    <div class="mobile-menu__head">
      <span class="mobile-menu__title">Menú</span>
      <button id="mobile-menu-close" class="hdr-icon-btn" aria-label="Cerrar menú">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="mobile-search-wrap">
      <form action="{{ routes.search_url }}" method="get" role="search" class="mobile-search-form">
        <input type="search" name="q" placeholder="Buscar..." class="mobile-search-input">
        <button type="submit" class="mobile-search-btn" aria-label="Buscar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
    </div>

    <nav class="mobile-nav">
      {% for link in linklists.main-menu.links %}
        {% assign link_url_lower = link.url | downcase %}

        {% if link.links != blank %}
          <div class="mobile-acc">
            <button class="mobile-accordion-header" aria-expanded="false">
              <span>{{ link.title }}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="mobile-brand-list">
              <a href="{{ link.url }}" class="mobile-brand-see-all">Ver todo {{ link.title }}</a>
              {% for child_link in link.links %}
                <a href="{{ child_link.url }}" class="mobile-brand-link">{{ child_link.title }}</a>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <a
            href="{{ link.url }}"
            class="mobile-nav-link {% if link_url_lower contains 'oferta' %}mobile-nav-link--sale{% endif %}"
          >{{ link.title }}</a>
        {% endif %}

      {% endfor %}
    </nav>
  </div>
  <div class="mobile-overlay" id="mobile-overlay"></div>

</header>

{% schema %}
{
  "name": "Encabezado",
  "settings": [],
  "presets": [{ "name": "Encabezado" }]
}
{% endschema %}
